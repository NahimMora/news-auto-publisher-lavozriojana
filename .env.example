# ============================================================
# AutoPublicador - La Voz Riojana
# Copiar este archivo a .env y completar los valores reales
# ============================================================

# ── FUENTES A SCRAPEAR ──────────────────────────────────────
# Secciones de tiempopopular.com.ar habilitadas (1=activo, 0=desactivado)
SCRAPER_LOCALES_ENABLED=1
SCRAPER_POLICIALES_ENABLED=1
SCRAPER_INTERIOR_ENABLED=1
SCRAPER_DEPORTES_ENABLED=1

# -- FUENTE: nuevarioja.com.ar ------------------------------
# Habilitar scraping de nuevarioja.com.ar (1=activo, 0=desactivado)
SCRAPER_NUEVARIOJA_ENABLED=1
SCRAPER_NR_POLITICA_ENABLED=1
SCRAPER_NR_SOCIEDAD_ENABLED=1
SCRAPER_NR_POLICIALES_ENABLED=1
SCRAPER_NR_DEPORTES_ENABLED=1
SCRAPER_NR_INTERIOR_ENABLED=1
SCRAPER_NR_INTERNACIONALES_ENABLED=1

# Máximo de artículos por ciclo por sección
SCRAPER_MAX_LINKS=8

# ── CICLO 24x7 ──────────────────────────────────────────────
PIPELINE_24X7_INTERVAL_SECONDS=3600
PIPELINE_24X7_HEARTBEAT_SECONDS=30
PIPELINE_24X7_STALE_SECONDS=900

# ── PUBLICACIÓN WEB ─────────────────────────────────────────
# Opciones: off | node_webapp
# Mantener off hasta completar credenciales/API/R2. Para habilitar: node_webapp
WEB_PUBLISH_TARGET=node_webapp

# WebApp Node.js (completar cuando esté lista)
WEBAPP_BASE_URL=https://lavozriojana.com.ar
PRIVATE_API_KEY=PENDIENTE
WEBAPP_DEFAULT_AUTHOR=Redacción La Voz Riojana
WEBAPP_REQUEST_TIMEOUT=30
WEBAPP_REQUEST_RETRIES=3
WEBAPP_RETRY_SLEEP_SECONDS=5
WEB_QUEUE_TTL_DAYS=30
WEB_DEDUP_HISTORY_DAYS=7

# true durante desarrollo: simula el publish de la pestana Publicaciones sin
# llamar a WebApp/Instagram/Facebook reales (ver pipeline/custom_post.py)
CUSTOM_POST_DRY_RUN=false

# ── IMÁGENES ────────────────────────────────────────────────
# Procesamiento de imágenes scrapeadas
IMAGE_MAX_WIDTH=1400
IMAGE_MAX_FILESIZE_KB=250
IMAGE_JPEG_QUALITY=82

# Imagen social (1200x630 para Facebook/Instagram)
SOCIAL_IMAGE_ENABLED=true
SOCIAL_IMAGE_WIDTH=1200
SOCIAL_IMAGE_HEIGHT=630
SOCIAL_IMAGE_TARGET_MIN_KB=100
SOCIAL_IMAGE_TARGET_MAX_KB=150
SOCIAL_IMAGE_HARD_MAX_KB=220
SOCIAL_IMAGE_JPEG_QUALITY_START=82
SOCIAL_IMAGE_JPEG_QUALITY_MIN=42

# Watermark / logo del medio (ruta al archivo de imagen)
# Completar cuando el logo esté disponible
WATERMARK_ENABLED=false
WATERMARK_IMAGE_PATH=assets/logo_lavozriojana.png
WATERMARK_POSITION=bottom-right
WATERMARK_OPACITY=0.85
WATERMARK_SCALE=0.18

# Layout de publicación visual (pendiente de definición)
# Opciones futuras: card | watermark | original
IMAGE_LAYOUT=original

# ── FACEBOOK ────────────────────────────────────────────────
FB_PAGE_ID=PENDIENTE
FB_PAGE_ACCESS_TOKEN=PENDIENTE
FB_APP_ID=PENDIENTE
FB_APP_SECRET=PENDIENTE
# IDs de páginas deshabilitadas (separados por coma)
FB_DISABLED_PAGE_IDS=
# Backoff en segundos cuando Meta bloquea temporalmente
FB_TEMP_BLOCK_BACKOFF_SECONDS=1800

# ── CLOUDFLARE R2 (hosting permanente de imágenes web/social) ─
# Crear bucket en Cloudflare R2, habilitar acceso público y generar API token
R2_ACCOUNT_ID=PENDIENTE
R2_ACCESS_KEY_ID=PENDIENTE
R2_SECRET_ACCESS_KEY=PENDIENTE
R2_BUCKET_NAME=PENDIENTE
# URL pública del bucket: https://pub-xxxx.r2.dev  o  https://media.tudominio.com
R2_PUBLIC_URL=https://media.lavozriojana.com
ENABLE_R2_OG_IMAGE=true

# ── INSTAGRAM ───────────────────────────────────────────────
IG_ACCOUNT_ID=PENDIENTE
IG_ACCESS_TOKEN=PENDIENTE
IG_APP_ID=PENDIENTE
IG_APP_SECRET=PENDIENTE
# Backoff cuando Meta devuelve "Application request limit reached" (code 4)
IG_RATE_LIMIT_BACKOFF_SECONDS=10800
# Ruta al perfil de Chrome para sesión de Instagram (si se usa Selenium)
IG_CHROME_PROFILE_DIR=PENDIENTE

# ── OPENAI ──────────────────────────────────────────────────
OPENAI_API_KEY=PENDIENTE
OPENAI_MODEL=gpt-4o-mini
ENABLE_EDITORIAL_NEWS_ENRICHER=true
EDITORIAL_ENRICHER_MODEL=gpt-4o-mini
EDITORIAL_ENRICHER_MAX_REVISIONS=5
EDITORIAL_ENRICHER_MIN_SCORE=0.86
OPENAI_RETRY_COUNT=4
OPENAI_RETRY_SLEEP=3
OPENAI_TIMEOUT=60

# ── THROTTLE DE PUBLICACIÓN ─────────────────────────────────
PUBLISH_THROTTLE_ENABLED=true
PUBLISH_DELAY_MIN_SECONDS=20
PUBLISH_DELAY_MAX_SECONDS=30
PUBLISH_BATCH_SIZE=10
PUBLISH_BATCH_PAUSE_SECONDS=180
# Límite de posts por ciclo (Instagram tiene tope de ~25/día via API)
# IG_MAX_PER_RUN sobreescribe PUBLISH_MAX_PER_RUN solo para Instagram
PUBLISH_MAX_PER_RUN=10
IG_MAX_PER_RUN=1
DEDUP_SIMILARITY_THRESHOLD=0.42

# ── FILTRO DE ANTIGÜEDAD ────────────────────────────────────
# Noticias con fecha de publicación más antigua que esto se descartan antes de procesar con IA
ARTICLE_MAX_AGE_DAYS=1

# ── FLAGS EDITORIALES (breaking / featured) ──────────────────
# Score mínimo (0.0-1.0) para que una nota sea isFeatured
# Aplica a categorías: politica, economia, interior, sociedad, policiales
FEATURED_MIN_QUALITY_SCORE=0.88

# ── VERIFICACIÓN DE MEDIOS ──────────────────────────────────
WEB_PUBLIC_MEDIA_CHECK_ENABLED=true
WEB_PUBLIC_MEDIA_CHECK_INITIAL_DELAY_SECONDS=2
WEB_PUBLIC_MEDIA_CHECK_ATTEMPTS=5
WEB_PUBLIC_MEDIA_CHECK_RETRY_SLEEP_SECONDS=5
