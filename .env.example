# AutoPublicador La Voz Riojana
# Copiar a .env y completar sólo las integraciones habilitadas.
# Nunca usar credenciales productivas en tests ni commitear .env.
#
# Dependencias:
#   ffmpeg + ffprobe: binarios de sistema, obligatorios para render de video (no se
#     instalan con pip; agregar su carpeta bin al PATH).
#   yt-dlp: declarado en requirements.txt (pip install -r requirements.txt lo deja en
#     el PATH del venv). Se actualiza seguido porque las plataformas rompen sus
#     extractors sin aviso — si empiezan a fallar descargas de una red puntual, correr
#     `pip install -U yt-dlp` primero. `python cli.py doctor --scope all` reporta su
#     presencia/versión.

# ── SCRAPING (opcionales; defaults mostrados) ──────────────────
SCRAPER_LOCALES_ENABLED=1
SCRAPER_POLICIALES_ENABLED=1
SCRAPER_INTERIOR_ENABLED=1
SCRAPER_DEPORTES_ENABLED=1
SCRAPER_NUEVARIOJA_ENABLED=1
SCRAPER_NR_POLITICA_ENABLED=1
SCRAPER_NR_SOCIEDAD_ENABLED=1
SCRAPER_NR_POLICIALES_ENABLED=1
SCRAPER_NR_DEPORTES_ENABLED=1
SCRAPER_NR_INTERIOR_ENABLED=1
SCRAPER_NR_INTERNACIONALES_ENABLED=1
# Fuente de farándula/espectáculos (paparazzi.com.ar). Apagada por defecto —
# ver docs/DECISIONS.md sobre el cupo reservado 8+2 de Instagram y el flujo de
# carrusel imagen+video antes de habilitarla en producción.
SCRAPER_PAPARAZZI_ENABLED=0
PAPARAZZI_EXCLUDED_CATEGORIES=horoscopo,branded-content
# paparazzi.com.ar devuelve 429 (Cloudflare) sin una pausa entre requests.
PAPARAZZI_REQUEST_DELAY_SECONDS=2.5
# Fuente de policiales nacional (infobae.com/sociedad/policiales/). Apagada
# hasta validar en un ciclo manual — ver docs/DECISIONS.md. Política propia:
# sólo se guarda lo que tiene video (JWPlayer, viene resuelto en el JSON-LD
# de la nota) o vínculo riojano (utils/editorial_router.detect_riojan_link);
# el resto se descarta en el scraping, antes de la reescritura.
SCRAPER_INFOBAE_POLICIALES_ENABLED=0
INFOBAE_REQUEST_DELAY_SECONDS=1.0
SCRAPER_MAX_LINKS=8
ARTICLE_MAX_AGE_DAYS=1
# Corte operativo opcional: no admite noticias anteriores a esta fecha.
ARTICLE_NOT_BEFORE_DATE=

# ── SUPERVISOR / ESTADOS ───────────────────────────────────────
# observe | web_only | web_facebook | web_instagram | all
# El modo nunca enciende un kill switch. Una contradicción falla en doctor.
PIPELINE_DEPLOYMENT_MODE=observe
PIPELINE_24X7_INTERVAL_SECONDS=3600
PIPELINE_24X7_HEARTBEAT_SECONDS=30
PIPELINE_24X7_STALE_SECONDS=900
REWRITE_MAX_ATTEMPTS=3
WEB_QUEUE_TTL_DAYS=30
SOCIAL_QUEUE_TTL_DAYS=30
SOCIAL_TTL_HOURS=48
QUEUE_EVENT_RETENTION_COUNT=10000

# Persistencia JSON: lock + escritura atómica + backup.
JSON_LOCK_TIMEOUT_SECONDS=10
JSON_LOCK_STALE_SECONDS=120
JSON_BACKUP_ENABLED=true
JSON_BACKUP_MIN_INTERVAL_SECONDS=3600
JSON_BACKUP_RETENTION_COUNT=20

# Logs rotativos.
LOG_MAX_MB=5
LOG_BACKUP_COUNT=3

# ── WEB / CMS ──────────────────────────────────────────────────
# Obligatorios sólo con WEB_PUBLISH_TARGET=node_webapp.
WEB_PUBLISH_TARGET=off
WEBAPP_BASE_URL=https://lavozriojana.com.ar
PRIVATE_API_KEY=PENDIENTE
# Alias legacy soportado, pero no configurar junto con PRIVATE_API_KEY:
# WEBAPP_API_KEY=PENDIENTE
WEBAPP_DEFAULT_AUTHOR=Redacción La Voz Riojana
WEBAPP_REQUEST_TIMEOUT=30
WEBAPP_REQUEST_RETRIES=3
WEBAPP_RETRY_SLEEP_SECONDS=5
# Endpoint autenticado GET y read-only. Sin uno real, preflight cms=blocked.
WEBAPP_PREFLIGHT_PATH=
# Plantilla DELETE opcional y exclusiva para cleanup canary; {id} es obligatorio.
WEBAPP_CANARY_DELETE_PATH=
WEB_DEDUP_HISTORY_DAYS=7

WEB_PUBLIC_MEDIA_CHECK_ENABLED=true
WEB_PUBLIC_MEDIA_CHECK_INITIAL_DELAY_SECONDS=2
WEB_PUBLIC_MEDIA_CHECK_ATTEMPTS=5
WEB_PUBLIC_MEDIA_CHECK_RETRY_SLEEP_SECONDS=5
ENABLE_R2_OG_IMAGE=true

# Política de fallback editorial:
# block | allow_non_sensitive | allow_all
# Policiales, judiciales, menores y breaking siempre quedan bloqueadas en
# allow_non_sensitive si se usó un fallback.
OPENAI_FALLBACK_MODE=allow_non_sensitive
WEB_EDITORIAL_FALLBACK_MODE=allow_non_sensitive

# ── GEMINI (Google AI) ───────────────────────────────────────────
# Obligatoria si OPENAI_FALLBACK_MODE=block. El nombre de esa variable es
# legacy (política de fallback genérica, no específica del proveedor de IA);
# no se renombró para no afectar despliegues existentes.
GEMINI_API_KEY=PENDIENTE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RETRY_COUNT=4
GEMINI_RETRY_SLEEP=3
GEMINI_TIMEOUT=60
ENABLE_EDITORIAL_NEWS_ENRICHER=true
EDITORIAL_ENRICHER_MODEL=gemini-3.1-flash-lite
EDITORIAL_ENRICHER_MAX_REVISIONS=5
EDITORIAL_ENRICHER_MIN_SCORE=0.86
# Al agotar seis intentos, conserva el último sólo si no quedan warnings
# factuales, judiciales o de HTML. Siempre se registra como degradado.
EDITORIAL_FINAL_ATTEMPT_ACTION=publish_last_safe
FEATURED_MIN_QUALITY_SCORE=0.88

# ── IMÁGENES / VIDEO ───────────────────────────────────────────
IMAGE_MIN_WIDTH=700
IMAGE_MAX_WIDTH=1400
IMAGE_MAX_PIXELS=40000000
IMAGE_DOWNLOAD_MAX_BYTES=20971520
IMAGE_MAX_FILESIZE_KB=250
IMAGE_JPEG_QUALITY=82
IMAGE_MIN_QUALITY=5
VIDEO_DOWNLOAD_MAX_BYTES=262144000
# Timeout del subproceso yt-dlp al descargar el video fuente de un reel.
YTDLP_TIMEOUT_SECONDS=180
# Ruta a un cookies.txt exportado de una sesión de navegador autenticada. Opcional:
# sólo hace falta si yt-dlp empieza a fallar con error_type=auth_required (Instagram/
# TikTok exigiendo login para cierto contenido). Usar una cuenta dedicada para esto,
# no la cuenta editorial principal, y no hacer login programático repetido — ver
# docs/RUNBOOK.md.
YTDLP_COOKIES_FILE=
# Sistema visual profesional del generador manual de Reels. Default seguro
# false: al activarlo usa EditorialReel (animaciones, tipografía y cierre v2)
# sin modificar los autopublicadores ni las colas Premium.
REEL_CINEMATIC_VISUAL_STYLE_ENABLED=false

# ── CLOUDFLARE R2 ──────────────────────────────────────────────
# Obligatorio para publicar en Web y para imágenes sociales generadas.
R2_ACCOUNT_ID=PENDIENTE
R2_ACCESS_KEY_ID=PENDIENTE
R2_SECRET_ACCESS_KEY=PENDIENTE
R2_BUCKET_NAME=PENDIENTE
R2_PUBLIC_URL=https://media.lavozriojana.com
R2_CONNECT_TIMEOUT_SECONDS=10
R2_READ_TIMEOUT_SECONDS=30
R2_RETRY_COUNT=3
R2_RETRY_BACKOFF_SECONDS=1

# ── FACEBOOK ───────────────────────────────────────────────────
FB_PUBLISH_ENABLED=false
FB_PAGE_ID=PENDIENTE
FB_PAGE_ACCESS_TOKEN=PENDIENTE
FB_DISABLED_PAGE_IDS=
FB_TEMP_BLOCK_BACKOFF_SECONDS=1800
FB_REQUEST_TIMEOUT_SECONDS=60
FB_VIDEO_REQUEST_TIMEOUT_SECONDS=120
# Verifica la nota pública y su og:image antes de enviar el post a Graph.
FB_LINK_PREWARM_ENABLED=true
FB_LINK_PREWARM_TIMEOUT_SECONDS=20
FB_LINK_PREWARM_MAX_BYTES=5242880
# Sólo habilitar si el valor de FB_PAGE_ACCESS_TOKEN ya es un Page Token.
FB_ALLOW_DIRECT_TOKEN_FALLBACK=false

# ── INSTAGRAM ──────────────────────────────────────────────────
IG_PUBLISH_ENABLED=false
IG_ACCOUNT_ID=PENDIENTE
IG_ACCESS_TOKEN=PENDIENTE
IG_RATE_LIMIT_BACKOFF_SECONDS=10800
IG_REQUEST_TIMEOUT_SECONDS=60
IG_VIDEO_PROCESSING_TIMEOUT_SECONDS=300
IG_VIDEO_PROCESSING_POLL_SECONDS=10
IG_IMAGE_CONTAINER_WAIT_SECONDS=5
PREMIUM_IG_CONTAINER_PROCESSING_TIMEOUT_SECONDS=240
PREMIUM_IG_CONTAINER_PROCESSING_POLL_SECONDS=2
# Qué se publica ya no lo decide este archivo por canal — lo decide
# select_publish_batch.py, un único lote (3 baldes) replicado en Web,
# Facebook e Instagram. IG_MAX_PER_RUN es sólo el ritmo de subida por
# corrida puntual (paceo de API), no un criterio editorial. Ver
# docs/DECISIONS.md y PUBLISH_LOCAL/PAPARAZZI/INFOBAE_MAX_PER_RUN más abajo.
IG_MAX_PER_RUN=10
# Tope de promociones manuales (candidatas aprobadas por el operador) que se
# drenan por corrida — evita que un backlog grande supere el timeout de la
# etapa. El resto sigue en la próxima corrida, no se pierde.
IG_MANUAL_OVERRIDE_MAX_PER_RUN=3
# Duración del video en el carrusel paparazzi (imagen+video). Las notas
# fuente son entrevistas largas, así que siempre se recorta al arranque: como
# máximo TOTAL_MAX_SECONDS del video real (120s), dividido en partes de a lo
# sumo PART_MAX_SECONDS (60s — límite de Instagram por hijo de video en un
# carrusel) — 2 slides de video si el recorte total supera los 60s.
PAPARAZZI_CAROUSEL_VIDEO_TOTAL_MAX_SECONDS=120
PAPARAZZI_CAROUSEL_VIDEO_PART_MAX_SECONDS=60
# Reel independiente de paparazzi (video solo, sin carrusel): apagado por
# defecto — no cambia el comportamiento actual hasta activación explícita.
# Cuando el carrusel/video estándar ya publicó una nota con video fuente,
# genera además un Reel con el mismo motor que la UI manual de Reels
# (127.0.0.1:8765 — Remotion EditorialReel con título superpuesto) y lo
# publica como segunda publicación independiente en IG/FB. Requiere R2
# configurado y, para cada plataforma, su propio IG_PUBLISH_ENABLED /
# FB_PUBLISH_ENABLED encendido. Ver docs/DECISIONS.md.
PAPARAZZI_REEL_ENABLED=false
# Duración de fallback (seg) sólo si el video fuente no se puede descargar al
# momento de renderizar el Reel (caso raro y transitorio: el clip normal del
# carrusel sí se descargó minutos antes). No se usa si la descarga funciona:
# ahí se usa la duración real del video fuente (tope de 90s, ver
# utils/video_renderer.py::render_video).
PAPARAZZI_REEL_FALLBACK_DURATION_SECONDS=20
# Portada del Reel en Instagram: milisegundos dentro del video a usar como
# miniatura (thumb_offset de Meta), en vez de la foto original de la noticia.
# Default 2500ms ≈ momento en que el título de EditorialReel ya achicó su
# animación de entrada. Sólo aplica a Instagram — la API clásica de video de
# Facebook no soporta elegir un frame por offset, así que ahí Facebook sigue
# usando su propio frame por defecto.
PAPARAZZI_REEL_THUMB_OFFSET_MS=2500
# Estadísticas de Instagram por categoría (meta/ig_insights.py): trae
# reach/total_interactions de las publicaciones recientes y agrega tasa de
# interacción por categoría (data/ig_category_performance.json). Solo lee de
# Graph API; apagado por defecto.
IG_STATS_ENABLED=false
IG_STATS_MAX_POSTS_PER_RUN=30
# Cuando está prendido, el router promueve a "automatic" una candidata sin
# vínculo riojano confirmado SI su categoría tiene rendimiento fuerte (ver
# docs/DECISIONS.md) — respeta igual el tope por tema (TOPIC_AUTOMATIC_CAP).
# Requiere IG_STATS_ENABLED=true para tener datos que promover.
IG_STATS_PROMOTION_ENABLED=false
IG_STATS_MIN_SAMPLE_SIZE=5
IG_STATS_PROMOTION_THRESHOLD_RATIO=1.0
# Paridad visual entre autopublicaciones y la pestaña Publicaciones. Apagado
# por default: al activarlo, el automático usa el mismo recuadro/panel,
# highlight verificable y salida 2160x2700 JPEG 4:4:4 que el flujo manual.
AUTOMATIC_MANUAL_VISUAL_STYLE_ENABLED=false
# Sistema visual Remotion (Fase 4 + rediseño "Editorial Cinemática Riojana",
# 2026-07-31): política por workflow, cada uno admite auto|remotion|pillow.
# Defaults seguros si NINGUNA de estas variables está definida (ni siquiera
# vacía): automático usa "auto" (intenta Remotion vía el servidor de render
# persistente, cae a Pillow sin bloquear una publicación real); OG usa
# "auto" y premium usa Remotion. Dejarlas comentadas para conservar esos
# defaults; descomentar sólo para forzar un motor distinto en este host.
# AUTOMATIC_STATIC_RENDER_ENGINE=auto
# PREMIUM_STATIC_RENDER_ENGINE=remotion
# OG_STATIC_RENDER_ENGINE=auto
# STATIC_RENDER_ENGINE es un override LEGACY: sólo aplica al workflow que no
# tenga su propia variable definida explícitamente arriba. No descomentar
# sin necesidad — activarla cambia el motor de automático/OG en silencio si
# sus variables específicas no están seteadas. Precedencia: variable
# específica del workflow > STATIC_RENDER_ENGINE (legacy) > default seguro.
# STATIC_RENDER_ENGINE=auto
# Publicaciones premium (Fase 3): dry-run no llama a ninguna API real.
PREMIUM_PUBLISH_DRY_RUN=false
# Si R2 falla, no usar la imagen original salvo decisión explícita.
IG_ALLOW_ORIGINAL_IMAGE_FALLBACK=false

# Endpoint común de Meta; normalmente no se cambia.
META_GRAPH_API=https://graph.facebook.com/v19.0

# ── CANARY (deshabilitado por defecto) ─────────────────────────────────────
# Además exige --confirm-external-publication. Nunca consume la cola general.
CANARY_ENABLED=false

# ── ALERTAS MÍNIMAS ────────────────────────────────────────────────────────
# Con webhook vacío, los eventos quedan en outbox local durable.
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_DEDUP_SECONDS=3600
ALERT_MAX_DELIVERY_ATTEMPTS=3
ALERT_RECOVERY_ENABLED=true
DISK_FREE_MIN_MB=1024

# ── TRAZABILIDAD DE DESPLIEGUE ─────────────────────────────────────────────
# Completar en el host; el heartbeat conserva estos campos sin secretos.
LVR_RELEASE_TAG=unreleased
LVR_DEPLOYED_AT=
LVR_DEPLOYMENT_OPERATOR=
LVR_BACKUP_REFERENCE=
LVR_COMMIT_SHA=

# ── SELECCIÓN DE LOTE (select_publish_batch.py) ─────────────────
# Un único lote por corrida, replicado igual en Web, Facebook e Instagram
# (ver docs/DECISIONS.md). "Local" = cualquier fuente que no sea paparazzi
# ni infobae, priorizando policiales/interior (orden editorial existente);
# los otros 2 baldes ordenan por video primero.
PUBLISH_LOCAL_MAX_PER_RUN=6
PUBLISH_PAPARAZZI_MAX_PER_RUN=2
PUBLISH_INFOBAE_MAX_PER_RUN=2
# Categorías que NUNCA completan el balde local aunque no haya nada más
# disponible esa corrida — la capacidad libre se reparte entre
# paparazzi/infobae en vez de usarse con relleno de bajo valor.
PUBLISH_LOCAL_EXCLUDED_CATEGORIES=deportes,espectaculos

# ── PRIORIZACIÓN / THROTTLE ────────────────────────────────────
# PUBLISH_MAX_PER_RUN es sólo paceo de API por corrida (Facebook), no
# criterio editorial — la curación ya la hizo select_publish_batch.py.
PUBLISH_MAX_PER_RUN=8
DEDUP_SIMILARITY_THRESHOLD=0.50
IG_POSTED_DEDUP_THRESHOLD=0.50
PUBLISH_THROTTLE_ENABLED=true
PUBLISH_DELAY_MIN_SECONDS=20
PUBLISH_DELAY_MAX_SECONDS=30
PUBLISH_BATCH_SIZE=10
PUBLISH_BATCH_PAUSE_SECONDS=180

# ── DESARROLLO / DIAGNÓSTICO ───────────────────────────────────
# Dry-run manual: no llama al CMS, Meta ni R2.
CUSTOM_POST_DRY_RUN=true
# Overrides para tests o instalaciones aisladas. Dejar vacíos en producción.
LVR_DATA_DIR=
LVR_LOGS_DIR=
LVR_OUTPUT_DIR=
LVR_FOTOS_DIR=
LVR_BACKUP_DIR=
LVR_QUARANTINE_DIR=
LVR_QUEUE_EVENTS_PATH=
LVR_ALERT_OUTBOX_PATH=
LVR_ALERT_STATE_PATH=
LVR_CANARY_STATE_PATH=
# Overrides internos de archivos JSON para tests de contrato.
LVR_STAGE_RESULT_PATH=
META_QUEUE_PATH=
SOCIAL_QUEUE_PATH=
FB_POSTED_PATH=
WEB_QUEUE_PATH=
WEB_PUBLISHED_HISTORY_PATH=

# ── OBSOLETAS (no configurar) ──────────────────────────────────
# IG_CHROME_PROFILE_DIR: no existe cliente Selenium.
# IMAGE_LAYOUT, SOCIAL_IMAGE_*, WATERMARK_*: nunca estuvieron conectadas al
# pipeline actual; se retiraron para no aparentar configuración efectiva.
# FB_APP_ID/FB_APP_SECRET e IG_APP_ID/IG_APP_SECRET: el flujo actual usa tokens
# ya emitidos y no consume estos valores.
